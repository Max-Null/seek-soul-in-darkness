{
  "name": "ssid-shell",
  "version": "0.1.13",
  "private": true,
  "description": "SSiD 壳（思灵）：Electron 补丁层，boot 隔壁 DSH 官方 UI（无边框自绘标题栏 + 托盘）",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node --import tsx/esm boot-smoke.ts",
    "pack": "npm run bundle-kernel && electron-builder --win nsis",
    "bundle-kernel": "esbuild kernel.ts --bundle --platform=node --format=esm --outfile=kernel.bundle.mjs --external:node:* --external:*.node"
  },
  "main": "main.mjs",
  "author": "MaxNull",
  "build": {
    "appId": "com.maxnull.ssid",
    "productName": "思灵",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!dsh-runtime/**",
      "!scripts/**",
      "!build/**",
      "!dist-electron/**",
      "!dist-electron-016/**",
      "!boot-smoke.ts",
      "!tsconfig.json"
    ],
    "asarUnpack": [
      "node_modules/tsx/**",
      "node_modules/@esbuild/**",
      "node_modules/pnpm/**"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "dsh-runtime.tar.gz",
        "to": "dsh-runtime.tar.gz"
      },
      {
        "from": "release-notes.md",
        "to": "release-notes.md"
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "思灵",
      "include": "build/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": true
    }
  },
  "dependencies": {
    "tsx": "^4.0.0",
    "pnpm": "11.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "electron": "43.3.0",
    "electron-builder": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
