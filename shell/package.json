{
  "name": "ssid-shell",
  "version": "0.1.0",
  "private": true,
  "description": "SSiD 壳（思灵）：Electron 补丁层，boot 隔壁 DSH 官方 UI 并外挂侧栏",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node --import tsx/esm boot-smoke.ts",
    "pack": "electron-builder --win portable"
  },
  "main": "main.mjs",
  "author": "MaxNull",
  "build": {
    "appId": "com.maxnull.ssid",
    "productName": "思灵",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "mammoth": "^1.12.1",
    "marked": "^18.0.9",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "electron": "43.3.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.5.0"
  }
}
