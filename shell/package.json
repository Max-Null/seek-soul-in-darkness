{
  "name": "ssid-shell",
  "version": "0.2.0",
  "private": true,
  "description": "SSiD 壳（思灵）：Electron 补丁层，boot 隔壁 DSH 官方 UI（无边框自绘标题栏 + 托盘）",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node --import tsx/esm boot-smoke.ts",
    "pack": "npm run bundle-kernel && electron-builder --win nsis",
    "bundle-kernel": "esbuild kernel.ts --bundle --platform=node --format=esm --outfile=kernel.bundle.mjs --external:node:* --external:*.node",
    "pack:mac": "npm run bundle-kernel && electron-builder --mac"
  },
  "main": "main.mjs",
  "author": "MaxNull",
  "build": {
    "appId": "com.maxnull.ssid",
    "productName": "思灵",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!dsh-runtime/**",
      "!scripts/**",
      "!build/**",
      "!dist-electron/**",
      "!dist-electron-016/**",
      "!tests/**",
      "!boot-smoke.ts",
      "!tsconfig.json",
      "!*.tar.gz"
    ],
    "asarUnpack": [
      "node_modules/tsx/**",
      "node_modules/@esbuild/**",
      "node_modules/pnpm/**"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "dsh-runtime.tar.gz",
        "to": "dsh-runtime.tar.gz"
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "思灵",
      "include": "build/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": true
    },
    "publish": {
      "provider": "github",
      "owner": "Max-Null",
      "repo": "seek-soul-in-darkness",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": "-"
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 130,
          "y": 230
        },
        {
          "x": 130,
          "y": 320,
          "type": "file",
          "path": "ssid-mac-launcher.command",
          "name": "打开思灵.command"
        },
        {
          "x": 410,
          "y": 230,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pnpm": "11.21.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.0",
    "typescript": "^6.0.3",
    "esbuild": "^0.28.2"
  }
}
